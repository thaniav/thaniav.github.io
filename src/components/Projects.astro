---
import { Card } from "./starwind/card";
import { projects } from "../data/portfolio";
import MagicWand from "./MagicWand.astro";
---

<section id="work">
  <div class="section-top">
    <h2>
      Projects{" "}
      <span class="heading-doodle" aria-hidden="true">
        <MagicWand />
      </span>
    </h2>
  </div>
  {projects.map((project) => (
    <Card as="article" class="project ring-0">
      <div>
        <h3>{project.title}</h3>
        <p>{project.description}</p>
        <p class="project-tech">{project.technologies}</p>
      </div>
      <span class="date">{project.date}</span>
    </Card>
  ))}
</section>
