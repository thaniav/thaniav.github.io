---
import MagicWand from "./MagicWand.astro";
---

<div
  class="role-art hubspot-art"
  tabindex="0"
  role="img"
  aria-label="Marketing workflow: trigger, delay, and action"
>
  <span class="art-doodle" aria-hidden="true">
    ✧
  </span>
  <div class="mini-workflow" aria-hidden="true">
    <div class="workflow-step">
      <span>◎</span>Trigger
    </div>
    <i></i>
    <div class="workflow-step">
      <span>◷</span>Delay
    </div>
    <i></i>
    <div class="workflow-step">
      <span>
        <MagicWand />
      </span>
      Action
    </div>
  </div>
</div>
